# ==============================================================================
# /etc/courier-backend.env - Production Environment Configuration Template
# ==============================================================================
# Secure permissions with: sudo chmod 600 /etc/courier-backend.env
# ==============================================================================

# Oracle Database Connection (Internal loopback only - never exposed publicly)
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
SPRING_DATASOURCE_USERNAME=COURIER_APP
SPRING_DATASOURCE_PASSWORD=YourSecureProductionPasswordHere

# Spring Boot Server Port (Internally proxied by Caddy/Nginx)
SERVER_PORT=8081

# Database Safety: Do not run initialization scripts if tables already exist
APP_DATABASE_AUTO_INIT=false