# ==============================================================================
# SwiftShip DBMS-DA3 Backend - Environment Variables Template
# ==============================================================================

# Server Configuration
# Koyeb injects PORT (default 8080). For local runs outside containers, defaults to 8082
PORT=8080
SERVER_PORT=8082

# Neo4j Database Configuration
# Local Neo4j (default):
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=12345678
NEO4J_DATABASE=neo4j

# Neo4j AuraDB (Cloud Production - set in Koyeb Dashboard):
# NEO4J_URI=neo4j+s://<dbid>.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=<your-auradb-password>
# NEO4J_DATABASE=neo4j

# CORS Configuration
# In production on Koyeb, set this to your exact Netlify production site origin (no trailing slash).
# Example: https://swiftship-courier.netlify.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8082
